generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// ENUMS
// ============================================================

enum UserStatus {
  ACTIVE
  SUSPENDED
  DISABLED
}

enum CustomerStatus {
  ACTIVE
  SUSPENDED
  DISABLED
}

enum CustomerTokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
  PHONE_OTP
  MAGIC_LINK
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum CartStatus {
  ACTIVE
  ABANDONED
  CONVERTED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  PARTIALLY_FULFILLED
  SHIPPED
  DELIVERED
  COMPLETED
  CANCELLED
  RETURNED
}

enum FulfillmentStatus {
  UNFULFILLED
  PARTIALLY_FULFILLED
  FULFILLED
  RETURNED
}

enum OrderAddressType {
  BILLING
  SHIPPING
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  PAID
  PARTIALLY_REFUNDED
  REFUNDED
  FAILED
  CANCELLED
}

enum PaymentTransactionStatus {
  PENDING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum PaymentMethod {
  CARD
  CASH_ON_DELIVERY
  BANK_TRANSFER
  DIGITAL_WALLET
  BNPL
  OTHER
}

enum PaymentTransactionType {
  AUTHORIZATION
  CAPTURE
  SALE
  REFUND
  VOID
  CHARGEBACK
}

enum ShipmentStatus {
  PENDING
  PROCESSING
  SHIPPED
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  FAILED
  RETURNED
  CANCELLED
}

enum InventoryMovementType {
  PURCHASE
  SALE
  RESERVATION
  RELEASE
  ADJUSTMENT
  RETURN
  TRANSFER_IN
  TRANSFER_OUT
  DAMAGE
  LOSS
}

enum InventoryReservationStatus {
  RESERVED
  RELEASED
  CONVERTED
  EXPIRED
  CANCELLED
}

enum TaxTreatment {
  STANDARD_RATED
  ZERO_RATED
  EXEMPT
  OUT_OF_SCOPE
  REVERSE_CHARGE
  OTHER
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  VOID
  CANCELLED
}

enum EInvoiceStatus {
  NOT_SUBMITTED
  PENDING
  SUBMITTED
  ACCEPTED
  REJECTED
  FAILED
}

enum ReturnStatus {
  REQUESTED
  APPROVED
  REJECTED
  RECEIVED
  INSPECTING
  COMPLETED
  CANCELLED
}

enum RefundStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
  FREE_SHIPPING
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum CreditNoteStatus {
  DRAFT
  ISSUED
  VOID
  CANCELLED
}

enum WebhookStatus {
  RECEIVED
  PROCESSED
  FAILED
  IGNORED
}

enum NotificationChannel {
  EMAIL
  SMS
  WHATSAPP
  PUSH
}

enum NotificationStatus {
  QUEUED
  SENT
  DELIVERED
  FAILED
}

// ============================================================
// STORE / BUSINESS
// ============================================================

model Store {
  id String @id @default(cuid())

  legalName   String
  tradingName String?

  email String?
  phone String?

  taxRegistrationNumber String?
  tradeLicenseNumber    String?

  countryCode String @default("AE")
  currency    String @default("AED")
  timezone    String @default("Asia/Dubai")

  defaultLocale    String   @default("en")
  supportedLocales String[] @default(["en", "ar"])

  addressLine1 String?
  addressLine2 String?
  building     String?
  street       String?
  area         String?
  city         String?
  emirate      String?
  postalCode   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============================================================
// DOCUMENT NUMBERING
// ============================================================

model DocumentSequence {
  key    String
  period String @default("")

  nextValue Int     @default(1)
  prefix    String?

  updatedAt DateTime @updatedAt

  @@id([key, period])
}

// ============================================================
// ADMIN / STAFF AUTHENTICATION
// ============================================================

model User {
  id            String  @id @default(cuid())
  name          String?
  email         String  @unique
  phone         String?  @unique
  avatarUrl     String?  
  passwordHash  String
  resetTokenHash      String?   @unique
  resetTokenExpiresAt DateTime?

  status UserStatus @default(ACTIVE)

  roles     UserRole[]
  sessions  UserSession[]
  auditLogs AuditLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Role {
  id          String  @id @default(cuid())
  name        String  @unique
  description String?

  users       UserRole[]
  permissions RolePermission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Permission {
  id          String  @id @default(cuid())
  name        String  @unique
  description String?

  roles RolePermission[]

  createdAt DateTime @default(now())
}

model UserRole {
  userId String
  roleId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model UserSession {
  id     String @id @default(cuid())
  userId String

  tokenHash String @unique

  ipAddress String?
  userAgent String?

  expiresAt  DateTime
  lastUsedAt DateTime?
  revokedAt  DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model LoginAttempt {
  id        String   @id @default(cuid())
  email     String?
  ipAddress String?
  success   Boolean
  createdAt DateTime @default(now())

  @@index([ipAddress, createdAt])
  @@index([email, createdAt])
}

// ============================================================
// CUSTOMER AUTHENTICATION
// ============================================================

model CustomerGroup {
  id String @id @default(cuid())

  name        String  @unique
  description String?

  customers  Customer[]
  priceLists PriceList[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Customer {
  id String @id @default(cuid())

  name  String?
  email String  @unique
  phone String?

  passwordHash String?

  status CustomerStatus @default(ACTIVE)

  emailVerifiedAt DateTime?
  phoneVerifiedAt DateTime?

  locale String @default("en")

  taxNumber String?

  marketingConsent   Boolean   @default(false)
  marketingConsentAt DateTime?

  groupId String?
  group   CustomerGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)

  sessions      CustomerSession[]
  addresses     CustomerAddress[]
  tokens        CustomerToken[]
  oauthAccounts CustomerOAuthAccount[]

  orders          Order[]
  carts           Cart[]
  wishlists       Wishlist[]
  reviews         Review[]
  reviewVotes     ReviewVote[]
  returns         ReturnRequest[]
  orderPromotions OrderPromotion[]
  notifications   Notification[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([phone])
  @@index([groupId])
}

model CustomerSession {
  id         String @id @default(cuid())
  customerId String

  tokenHash String @unique

  ipAddress String?
  userAgent String?

  expiresAt  DateTime
  lastUsedAt DateTime?
  revokedAt  DateTime?

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([customerId])
  @@index([expiresAt])
}

model CustomerToken {
  id         String @id @default(cuid())
  customerId String

  type      CustomerTokenType
  tokenHash String            @unique

  attempts Int @default(0)

  expiresAt DateTime
  usedAt    DateTime?

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([customerId, type])
  @@index([expiresAt])
}

model CustomerOAuthAccount {
  id         String @id @default(cuid())
  customerId String

  provider          String
  providerAccountId String

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([provider, providerAccountId])
  @@index([customerId])
}

model CustomerAddress {
  id         String @id @default(cuid())
  customerId String

  label String?

  recipientName String
  phone         String?

  countryCode String  @default("AE")
  emirate     String?
  city        String?
  area        String?
  street      String?
  building    String?
  unit        String?

  addressLine1 String
  addressLine2 String?
  postalCode   String?

  isDefault Boolean @default(false)

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
}

// ============================================================
// TAX
// ============================================================

model TaxRate {
  id String @id @default(cuid())

  name String
  code String @unique

  rate      Decimal      @db.Decimal(8, 4)
  treatment TaxTreatment

  countryCode String?
  region      String?

  validFrom DateTime
  validTo   DateTime?

  active Boolean @default(true)

  products Product[]
  variants ProductVariant[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([countryCode])
  @@index([active])
  @@index([validFrom, validTo])
}

// ============================================================
// CATALOG
// ============================================================

model Brand {
  id String @id @default(cuid())

  name        String
  slug        String  @unique
  description String?
  logoUrl     String?

  products     Product[]
  translations BrandTranslation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Category {
  id String @id @default(cuid())

  name        String
  slug        String  @unique
  description String?

  metaTitle       String?
  metaDescription String?

  parentId String?

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryTree")

  products     ProductCategory[]
  promotions   PromotionCategory[]
  translations CategoryTranslation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([parentId])
}

model Product {
  id String @id @default(cuid())

  name String
  slug String @unique

  description      String?
  shortDescription String?

  status      ProductStatus @default(DRAFT)
  publishedAt DateTime?

  brandId   String?
  taxRateId String?

  metaTitle       String?
  metaDescription String?

  brand   Brand?   @relation(fields: [brandId], references: [id], onDelete: SetNull)
  taxRate TaxRate? @relation(fields: [taxRateId], references: [id], onDelete: SetNull)

  categories   ProductCategory[]
  collections  ProductCollection[]
  tags         ProductTag[]
  attributes   ProductAttribute[]
  options      ProductOption[]
  variants     ProductVariant[]
  images       ProductImage[]
  translations ProductTranslation[]

  promotions PromotionProduct[]
  reviews    Review[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([brandId])
  @@index([taxRateId])
  @@index([status])
  @@index([deletedAt])
}

model ProductCategory {
  productId  String
  categoryId String

  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([productId, categoryId])
  @@index([categoryId])
}

model ProductImage {
  id String @id @default(cuid())

  productId String
  variantId String?

  url       String
  altText   String?
  sortOrder Int     @default(0)

  product Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([productId])
  @@index([variantId])
}

model ProductOption {
  id String @id @default(cuid())

  productId String
  name      String

  product Product              @relation(fields: [productId], references: [id], onDelete: Cascade)
  values  ProductOptionValue[]

  createdAt DateTime @default(now())

  @@unique([productId, name])
}

model ProductOptionValue {
  id String @id @default(cuid())

  optionId String
  value    String

  option   ProductOption        @relation(fields: [optionId], references: [id], onDelete: Cascade)
  variants VariantOptionValue[]

  createdAt DateTime @default(now())

  @@unique([optionId, value])
}

model ProductVariant {
  id String @id @default(cuid())

  productId String

  sku     String  @unique
  barcode String? @unique

  name String?

  price          Decimal  @db.Decimal(18, 2)
  compareAtPrice Decimal? @db.Decimal(18, 2)
  costPrice      Decimal? @db.Decimal(18, 2)

  weight Decimal? @db.Decimal(12, 3)

  trackInventory    Boolean @default(true)
  allowBackorder    Boolean @default(false)
  lowStockThreshold Int?

  taxRateId String?

  product Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  taxRate TaxRate? @relation(fields: [taxRateId], references: [id], onDelete: SetNull)

  optionValues   VariantOptionValue[]
  images         ProductImage[]
  translations   ProductVariantTranslation[]
  priceListItems PriceListItem[]

  inventory     InventoryItem[]
  movements     InventoryMovement[]
  cartItems     CartItem[]
  orderItems    OrderItem[]
  wishlistItems WishlistItem[]
  reviews       Review[]
  returnItems   ReturnItem[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([productId])
  @@index([taxRateId])
  @@index([deletedAt])
}

model VariantOptionValue {
  variantId     String
  optionValueId String

  variant     ProductVariant     @relation(fields: [variantId], references: [id], onDelete: Cascade)
  optionValue ProductOptionValue @relation(fields: [optionValueId], references: [id], onDelete: Cascade)

  @@id([variantId, optionValueId])
  @@index([optionValueId])
}

// ============================================================
// CATALOG: LOCALIZATION
// ============================================================

model ProductTranslation {
  id String @id @default(cuid())

  productId String
  locale    String

  name             String
  slug             String
  description      String?
  shortDescription String?
  metaTitle        String?
  metaDescription  String?

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, locale])
  @@unique([locale, slug])
}

model ProductVariantTranslation {
  id String @id @default(cuid())

  variantId String
  locale    String

  name String?

  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([variantId, locale])
}

model CategoryTranslation {
  id String @id @default(cuid())

  categoryId String
  locale     String

  name            String
  slug            String
  description     String?
  metaTitle       String?
  metaDescription String?

  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([categoryId, locale])
  @@unique([locale, slug])
}

model BrandTranslation {
  id String @id @default(cuid())

  brandId String
  locale  String

  name        String
  description String?

  brand Brand @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@unique([brandId, locale])
}

// ============================================================
// CATALOG: MERCHANDISING
// ============================================================

model Collection {
  id String @id @default(cuid())

  name        String
  slug        String  @unique
  description String?

  active    Boolean @default(true)
  sortOrder Int     @default(0)

  products ProductCollection[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ProductCollection {
  collectionId String
  productId    String

  sortOrder Int @default(0)

  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  product    Product    @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([collectionId, productId])
  @@index([productId])
}

model Tag {
  id String @id @default(cuid())

  name String @unique
  slug String @unique

  products ProductTag[]

  createdAt DateTime @default(now())
}

model ProductTag {
  productId String
  tagId     String

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([productId, tagId])
  @@index([tagId])
}

model ProductAttribute {
  id String @id @default(cuid())

  productId String

  name  String
  value String

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([name, value])
}

// ============================================================
// PRICING
// ============================================================

model PriceList {
  id String @id @default(cuid())

  name     String
  currency String @default("AED")

  customerGroupId String?

  priority Int     @default(0)
  active   Boolean @default(true)

  startsAt DateTime?
  endsAt   DateTime?

  customerGroup CustomerGroup?  @relation(fields: [customerGroupId], references: [id], onDelete: SetNull)
  items         PriceListItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerGroupId])
  @@index([active, startsAt, endsAt])
}

model PriceListItem {
  id String @id @default(cuid())

  priceListId String
  variantId   String

  minQuantity Int @default(1)

  price          Decimal  @db.Decimal(18, 2)
  compareAtPrice Decimal? @db.Decimal(18, 2)

  priceList PriceList      @relation(fields: [priceListId], references: [id], onDelete: Cascade)
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([priceListId, variantId, minQuantity])
  @@index([variantId])
}

// ============================================================
// WAREHOUSE / INVENTORY
// ============================================================

model Warehouse {
  id String @id @default(cuid())

  code   String  @unique
  name   String
  active Boolean @default(true)

  countryCode  String  @default("AE")
  emirate      String?
  city         String?
  area         String?
  addressLine1 String?
  addressLine2 String?

  inventory InventoryItem[]
  movements InventoryMovement[]
  shipments Shipment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model InventoryItem {
  id String @id @default(cuid())

  warehouseId String
  variantId   String

  quantity Int @default(0)
  reserved Int @default(0)

  warehouse Warehouse      @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  movements    InventoryMovement[]
  reservations InventoryReservation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([warehouseId, variantId])
  @@index([variantId])
}

model InventoryMovement {
  id String @id @default(cuid())

  inventoryItemId String
  warehouseId     String
  variantId       String

  type InventoryMovementType

  // Signed delta (append-only ledger; never update or delete rows).
  // RESERVATION (+) and RELEASE (-) change InventoryItem.reserved.
  // Every other type changes InventoryItem.quantity.
  // Sign per type is enforced in constraints.sql.
  quantity Int

  referenceType String?
  referenceId   String?

  note String?

  inventoryItem InventoryItem  @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)
  warehouse     Warehouse      @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  variant       ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())

  @@index([inventoryItemId])
  @@index([warehouseId])
  @@index([variantId])
  @@index([referenceType, referenceId])
}

model InventoryReservation {
  id String @id @default(cuid())

  inventoryItemId String
  orderItemId     String?

  quantity Int
  status   InventoryReservationStatus

  expiresAt DateTime?

  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  orderItem     OrderItem?    @relation(fields: [orderItemId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([inventoryItemId])
  @@index([orderItemId])
  @@index([status])
  @@index([expiresAt])
}

// ============================================================
// CART
// ============================================================

model Cart {
  id String @id @default(cuid())

  customerId   String?
  sessionToken String? @unique

  status CartStatus @default(ACTIVE)

  currency   String  @default("AED")
  couponCode String?

  expiresAt DateTime?

  customer Customer?  @relation(fields: [customerId], references: [id], onDelete: SetNull)
  items    CartItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
  @@index([status])
  @@index([expiresAt])
}

model CartItem {
  id String @id @default(cuid())

  cartId    String
  variantId String

  quantity Int

  // Price shown to the customer when the item was added or last refreshed.
  // Re-price at checkout and flag the change if it differs.
  unitPriceSnapshot Decimal? @db.Decimal(18, 2)

  cart    Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([cartId, variantId])
}

// ============================================================
// WISHLIST
// ============================================================

model Wishlist {
  id String @id @default(cuid())

  customerId String
  name       String @default("Default")

  customer Customer       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  items    WishlistItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
}

model WishlistItem {
  id String @id @default(cuid())

  wishlistId String
  variantId  String

  wishlist Wishlist       @relation(fields: [wishlistId], references: [id], onDelete: Cascade)
  variant  ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([wishlistId, variantId])
}

// ============================================================
// ORDERS
// ============================================================

model Order {
  id String @id @default(cuid())

  orderNumber    String  @unique
  idempotencyKey String? @unique

  customerId String?

  customerName      String?
  customerEmail     String?
  customerPhone     String?
  customerTaxNumber String?

  locale   String @default("en")
  currency String @default("AED")

  status            OrderStatus       @default(PENDING)
  paymentStatus     PaymentStatus     @default(PENDING)
  fulfillmentStatus FulfillmentStatus @default(UNFULFILLED)

  // true = unit prices already include VAT.
  // This does NOT hardcode any tax rate.
  pricesIncludeTax Boolean @default(true)

  subtotal      Decimal @db.Decimal(18, 2)
  discountTotal Decimal @default(0) @db.Decimal(18, 2)
  shippingTotal Decimal @default(0) @db.Decimal(18, 2)
  taxTotal      Decimal @default(0) @db.Decimal(18, 2)
  total         Decimal @db.Decimal(18, 2)

  shippingMethodId String?
  deliveryEmirate  String?

  notes         String?
  internalNotes String?

  placedAt     DateTime  @default(now())
  cancelledAt  DateTime?
  cancelReason String?

  customer       Customer?       @relation(fields: [customerId], references: [id], onDelete: SetNull)
  shippingMethod ShippingMethod? @relation(fields: [shippingMethodId], references: [id], onDelete: SetNull)

  items         OrderItem[]
  addresses     OrderAddress[]
  taxes         OrderTaxLine[]
  statusHistory OrderStatusHistory[]

  payments  Payment[]
  refunds   Refund[]
  shipments Shipment[]

  promotions OrderPromotion[]

  invoice Invoice?

  returns          ReturnRequest[]
  notificationLogs Notification[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
  @@index([status])
  @@index([paymentStatus])
  @@index([fulfillmentStatus])
  @@index([deliveryEmirate])
  @@index([createdAt])
}

model OrderItem {
  id String @id @default(cuid())

  orderId   String
  variantId String

  productName String
  variantName String?
  sku         String

  quantity Int

  unitPrice     Decimal @db.Decimal(18, 2)
  discountTotal Decimal @default(0) @db.Decimal(18, 2)
  taxTotal      Decimal @default(0) @db.Decimal(18, 2)
  total         Decimal @db.Decimal(18, 2)

  order   Order          @relation(fields: [orderId], references: [id], onDelete: Restrict)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  taxes         OrderItemTaxLine[]
  reservations  InventoryReservation[]
  shipmentItems ShipmentItem[]
  returnItems   ReturnItem[]
  reviews       Review[]

  createdAt DateTime @default(now())

  @@index([orderId])
  @@index([variantId])
}

model OrderAddress {
  id String @id @default(cuid())

  orderId String
  type    OrderAddressType

  recipientName String
  phone         String?

  countryCode String  @default("AE")
  emirate     String?
  city        String?
  area        String?
  street      String?
  building    String?
  unit        String?

  addressLine1 String
  addressLine2 String?
  postalCode   String?

  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())

  @@unique([orderId, type])
}

model OrderStatusHistory {
  id String @id @default(cuid())

  orderId    String
  fromStatus OrderStatus?
  toStatus   OrderStatus

  note String?

  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())

  @@index([orderId])
}

// ============================================================
// ORDER TAX SNAPSHOTS
// ============================================================

model OrderTaxLine {
  id String @id @default(cuid())

  orderId String

  name      String
  code      String
  rate      Decimal      @db.Decimal(8, 4)
  treatment TaxTreatment
  amount    Decimal      @db.Decimal(18, 2)

  jurisdiction String?

  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())

  @@index([orderId])
}

model OrderItemTaxLine {
  id String @id @default(cuid())

  orderItemId String

  name      String
  code      String
  rate      Decimal      @db.Decimal(8, 4)
  treatment TaxTreatment
  amount    Decimal      @db.Decimal(18, 2)

  orderItem OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([orderItemId])
}

// ============================================================
// PAYMENTS
// ============================================================

model Payment {
  id String @id @default(cuid())

  orderId String

  method PaymentMethod
  status PaymentStatus

  currency String
  amount   Decimal @db.Decimal(18, 2)

  provider          String?
  providerReference String?

  transactions PaymentTransaction[]
  refunds      Refund[]

  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId])
  @@index([status])
  @@index([providerReference])
}

model PaymentTransaction {
  id String @id @default(cuid())

  paymentId String

  type   PaymentTransactionType
  status PaymentTransactionStatus

  amount   Decimal @db.Decimal(18, 2)
  currency String

  providerReference String?
  metadata          Json?

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())

  @@index([paymentId])
  @@index([providerReference])
}

model Refund {
  id String @id @default(cuid())

  paymentId String
  orderId   String

  amount   Decimal @db.Decimal(18, 2)
  currency String

  status RefundStatus @default(PENDING)

  providerReference String?
  reason            String?

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  order   Order   @relation(fields: [orderId], references: [id], onDelete: Restrict)

  returnRequest ReturnRequest?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([paymentId])
  @@index([orderId])
}

// ============================================================
// WEBHOOK / EVENT INBOX
// ============================================================

model WebhookEvent {
  id String @id @default(cuid())

  provider String
  eventId  String
  type     String

  status   WebhookStatus @default(RECEIVED)
  attempts Int           @default(0)
  error    String?

  payload Json

  receivedAt  DateTime  @default(now())
  processedAt DateTime?

  @@unique([provider, eventId])
  @@index([status])
  @@index([receivedAt])
}

// ============================================================
// SHIPPING
// ============================================================

model ShippingZone {
  id String @id @default(cuid())

  name        String
  countryCode String  @default("AE")
  emirate     String?

  active Boolean @default(true)

  rates ShippingRate[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([countryCode])
  @@index([emirate])
}

model ShippingMethod {
  id String @id @default(cuid())

  name String
  code String @unique

  active Boolean @default(true)

  rates     ShippingRate[]
  shipments Shipment[]
  orders    Order[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ShippingRate {
  id String @id @default(cuid())

  shippingZoneId   String
  shippingMethodId String

  price    Decimal @db.Decimal(18, 2)
  currency String  @default("AED")

  minOrderAmount Decimal? @db.Decimal(18, 2)
  maxOrderAmount Decimal? @db.Decimal(18, 2)

  minWeight Decimal? @db.Decimal(12, 3)
  maxWeight Decimal? @db.Decimal(12, 3)

  active Boolean @default(true)

  shippingZone   ShippingZone   @relation(fields: [shippingZoneId], references: [id], onDelete: Cascade)
  shippingMethod ShippingMethod @relation(fields: [shippingMethodId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([shippingZoneId])
  @@index([shippingMethodId])
}

model Shipment {
  id String @id @default(cuid())

  orderId          String
  warehouseId      String
  shippingMethodId String

  trackingNumber String?
  carrier        String?

  status ShipmentStatus @default(PENDING)

  shippedAt   DateTime?
  deliveredAt DateTime?

  order          Order          @relation(fields: [orderId], references: [id], onDelete: Restrict)
  warehouse      Warehouse      @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  shippingMethod ShippingMethod @relation(fields: [shippingMethodId], references: [id], onDelete: Restrict)

  items  ShipmentItem[]
  events ShipmentEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId])
  @@index([warehouseId])
  @@index([trackingNumber])
}

model ShipmentItem {
  id String @id @default(cuid())

  shipmentId  String
  orderItemId String

  quantity Int

  shipment  Shipment  @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  orderItem OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())

  @@index([shipmentId])
  @@index([orderItemId])
}

model ShipmentEvent {
  id String @id @default(cuid())

  shipmentId String

  status      ShipmentStatus
  description String?
  location    String?

  occurredAt DateTime
  raw        Json?

  shipment Shipment @relation(fields: [shipmentId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())

  @@index([shipmentId, occurredAt])
}

// ============================================================
// PROMOTIONS
// ============================================================

model Promotion {
  id String @id @default(cuid())

  name        String
  description String?

  type  DiscountType
  value Decimal      @default(0) @db.Decimal(18, 2)

  minimumOrderAmount Decimal? @db.Decimal(18, 2)

  usageLimit       Int?
  usageCount       Int  @default(0)
  perCustomerLimit Int?

  stackable Boolean @default(false)
  priority  Int     @default(0)

  startsAt DateTime?
  endsAt   DateTime?

  active Boolean @default(true)

  codes PromotionCode[]

  products   PromotionProduct[]
  categories PromotionCategory[]

  orders OrderPromotion[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PromotionCode {
  id String @id @default(cuid())

  promotionId String
  code        String @unique

  usageLimit Int?
  usageCount Int  @default(0)

  active Boolean @default(true)

  promotion Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)

  redemptions OrderPromotion[]

  createdAt DateTime @default(now())

  @@index([promotionId])
}

model PromotionProduct {
  promotionId String
  productId   String

  promotion Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([promotionId, productId])
  @@index([productId])
}

model PromotionCategory {
  promotionId String
  categoryId  String

  promotion Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  category  Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([promotionId, categoryId])
  @@index([categoryId])
}

model OrderPromotion {
  id String @id @default(cuid())

  orderId         String
  promotionId     String
  promotionCodeId String?
  customerId      String?

  code   String?
  amount Decimal @db.Decimal(18, 2)

  order         Order          @relation(fields: [orderId], references: [id], onDelete: Restrict)
  promotion     Promotion      @relation(fields: [promotionId], references: [id], onDelete: Restrict)
  promotionCode PromotionCode? @relation(fields: [promotionCodeId], references: [id], onDelete: SetNull)
  customer      Customer?      @relation(fields: [customerId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([orderId])
  @@index([promotionId])
  @@index([promotionCodeId])
  @@index([promotionId, customerId])
}

// ============================================================
// REVIEWS
// ============================================================

model Review {
  id String @id @default(cuid())

  customerId  String
  productId   String
  variantId   String?
  orderItemId String?

  rating Int
  title  String?
  body   String?

  isVerifiedPurchase Boolean @default(false)
  helpfulCount       Int     @default(0)

  status ReviewStatus @default(PENDING)

  customer  Customer        @relation(fields: [customerId], references: [id], onDelete: Cascade)
  product   Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  orderItem OrderItem?      @relation(fields: [orderItemId], references: [id], onDelete: SetNull)

  images ReviewImage[]
  votes  ReviewVote[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // One review per purchased line item.
  // Postgres permits multiple NULLs.
  @@unique([orderItemId])
  @@index([customerId, productId])
  @@index([productId])
  @@index([variantId])
  @@index([status])
}

model ReviewImage {
  id String @id @default(cuid())

  reviewId String

  url       String
  altText   String?
  sortOrder Int     @default(0)

  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([reviewId])
}

model ReviewVote {
  reviewId   String
  customerId String

  helpful Boolean @default(true)

  review   Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([reviewId, customerId])
  @@index([customerId])
}

// ============================================================
// RETURNS
// ============================================================

model ReturnRequest {
  id String @id @default(cuid())

  orderId    String
  customerId String?

  status ReturnStatus @default(REQUESTED)

  reason String?
  note   String?

  refundId     String? @unique
  creditNoteId String? @unique

  order      Order       @relation(fields: [orderId], references: [id], onDelete: Restrict)
  customer   Customer?   @relation(fields: [customerId], references: [id], onDelete: SetNull)
  refund     Refund?     @relation(fields: [refundId], references: [id], onDelete: SetNull)
  creditNote CreditNote? @relation(fields: [creditNoteId], references: [id], onDelete: SetNull)

  items ReturnItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId])
  @@index([customerId])
  @@index([status])
}

model ReturnItem {
  id String @id @default(cuid())

  returnRequestId String
  orderItemId     String
  variantId       String

  quantity Int
  reason   String?

  restock     Boolean   @default(false)
  restockedAt DateTime?

  returnRequest ReturnRequest  @relation(fields: [returnRequestId], references: [id], onDelete: Cascade)
  orderItem     OrderItem      @relation(fields: [orderItemId], references: [id], onDelete: Restrict)
  variant       ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())

  @@index([returnRequestId])
  @@index([orderItemId])
  @@index([variantId])
}

// ============================================================
// INVOICING
// ============================================================

model Invoice {
  id String @id @default(cuid())

  orderId String @unique

  invoiceNumber String @unique

  status         InvoiceStatus  @default(DRAFT)
  eInvoiceStatus EInvoiceStatus @default(NOT_SUBMITTED)

  issueDate DateTime
  dueDate   DateTime?

  currency String

  supplierLegalName   String
  supplierTradingName String?
  supplierTaxNumber   String?

  customerName      String?
  customerEmail     String?
  customerTaxNumber String?

  subtotal      Decimal @db.Decimal(18, 2)
  discountTotal Decimal @default(0) @db.Decimal(18, 2)
  taxTotal      Decimal @default(0) @db.Decimal(18, 2)
  total         Decimal @db.Decimal(18, 2)

  eInvoiceId          String?
  eInvoiceProvider    String?
  eInvoiceSubmittedAt DateTime?
  eInvoiceError       String?

  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)

  address     InvoiceAddress?
  items       InvoiceItem[]
  creditNotes CreditNote[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([eInvoiceStatus])
}

model InvoiceAddress {
  id String @id @default(cuid())

  invoiceId String @unique

  recipientName String?
  countryCode   String  @default("AE")
  emirate       String?
  city          String?
  area          String?
  street        String?
  building      String?
  unit          String?

  addressLine1 String
  addressLine2 String?
  postalCode   String?

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

model InvoiceItem {
  id String @id @default(cuid())

  invoiceId String

  productName String
  variantName String?
  sku         String?

  quantity Int

  unitPrice     Decimal      @db.Decimal(18, 2)
  discountTotal Decimal      @default(0) @db.Decimal(18, 2)
  taxCode       String
  taxTreatment  TaxTreatment
  taxRate       Decimal      @db.Decimal(8, 4)
  taxAmount     Decimal      @db.Decimal(18, 2)
  total         Decimal      @db.Decimal(18, 2)

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([invoiceId])
}

model CreditNote {
  id String @id @default(cuid())

  invoiceId String

  creditNoteNumber String @unique

  status CreditNoteStatus @default(DRAFT)

  issueDate DateTime
  currency  String

  subtotal Decimal @db.Decimal(18, 2)
  taxTotal Decimal @default(0) @db.Decimal(18, 2)
  total    Decimal @db.Decimal(18, 2)

  reason String?

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)

  items         CreditNoteItem[]
  returnRequest ReturnRequest?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([invoiceId])
}

model CreditNoteItem {
  id String @id @default(cuid())

  creditNoteId String

  productName String
  sku         String?

  quantity Int

  unitPrice    Decimal      @db.Decimal(18, 2)
  taxCode      String
  taxTreatment TaxTreatment
  taxRate      Decimal      @db.Decimal(8, 4)
  taxAmount    Decimal      @db.Decimal(18, 2)
  total        Decimal      @db.Decimal(18, 2)

  creditNote CreditNote @relation(fields: [creditNoteId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([creditNoteId])
}

// ============================================================
// MARKETING / NOTIFICATIONS
// ============================================================

model NewsletterSubscriber {
  id String @id @default(cuid())

  email  String  @unique
  locale String  @default("en")
  source String?

  subscribedAt   DateTime  @default(now())
  unsubscribedAt DateTime?
}

model Notification {
  id String @id @default(cuid())

  customerId String?
  orderId    String?

  channel   NotificationChannel
  template  String
  recipient String

  status            NotificationStatus @default(QUEUED)
  providerReference String?
  error             String?

  sentAt DateTime?

  customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  order    Order?    @relation(fields: [orderId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([customerId])
  @@index([orderId])
  @@index([status])
  @@index([createdAt])
}

// ============================================================
// AUDIT
// ============================================================

model AuditLog {
  id String @id @default(cuid())

  userId String?

  action     String
  entityType String
  entityId   String?

  metadata Json?

  ipAddress String?
  userAgent String?

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([entityType, entityId])
  @@index([createdAt])
}
